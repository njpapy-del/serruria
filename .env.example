# URL publique du site (utilisée pour le sitemap, les canonicals, l'Open Graph)
NEXT_PUBLIC_SITE_URL=https://serrurerielouisfils.com

# Google Tag Manager — laisser vide pour ne charger aucun script de tracking
# (GA4 et les conversions Google Ads se configurent ensuite DANS le conteneur GTM,
# aucun identifiant Ads ne doit être mis ici)
NEXT_PUBLIC_GTM_ID=

# Envoi d'email du formulaire de rappel via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFICATION_EMAIL=

# Espace admin (/admin) — mot de passe unique + secret de signature de session
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Utilisé par l'espace admin pour enregistrer les modifications (prix, photos,
# textes) sous forme de commit sur le dépôt GitHub du site.
GITHUB_TOKEN=
GITHUB_REPO=njpapy-del/serruria
GITHUB_BRANCH=main
