[Unit]
Description=Lead Radar — rapport Search Console hebdomadaire
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=leadradar
Group=leadradar
WorkingDirectory=/opt/lead-radar/agent
EnvironmentFile=/etc/lead-radar.env
ExecStart=/usr/bin/python3 -m lead_radar_agent --mode gsc-report
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
