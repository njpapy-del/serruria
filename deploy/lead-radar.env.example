# /etc/lead-radar.env — droits 600, propriétaire root. JAMAIS dans Git.
# Remplir avec les NOUVELLES clés (les anciennes, exposées, doivent être révoquées).
RESEND_API_KEY=
LEAD_RADAR_SENDER_EMAIL=Lead Radar <radar@serrurerielouisfils.com>
LEAD_RADAR_NOTIFICATION_EMAIL=
BRAVE_SEARCH_API_KEY=
# Sur le serveur, l'état est conservé sur disque : les plafonds Brave (par jour,
# par mois, créneaux) sont fiables. Laisser à true pour autoriser Brave.
RADAR_ALLOW_PAID=true
# Signal de vie (Healthchecks.io ou compatible) : alerte si aucun passage.
HEALTHCHECK_PING_URL=
# Search Console (étape 2), facultatif
GSC_SERVICE_ACCOUNT_JSON=
GSC_PROPERTY=
# Envoi des passages au tableau de bord (étape 4), facultatif
RADAR_INGEST_URL=https://serrurerielouisfils.com/api/radar/ingest
RADAR_INGEST_TOKEN=
